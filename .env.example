# Copy only if .env does not exist. chmod 600 .env. Never commit real values.
# Generate each secret independently, e.g. python -c 'import secrets; print(secrets.token_hex(32))'
# Use URL-safe hex passwords: they are also interpolated into connection URLs.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
API_KEY=
WEBHOOK_SECRET=
# Required JSON list: base domains also allow all their subdomains.
WEBHOOK_ALLOWED_DOMAINS='["hooks.example.com"]'
ENVIRONMENT=production
ALLOW_UNSAFE_WEBHOOKS=false
API_PORT=8000
RETRY_BASE_SECONDS=2
# Total authenticated request body read budget (seconds), finite and >0; not keep-alive.
HTTP_BODY_TIMEOUT_SECONDS=10
# Explicit development demo ONLY:
# ENVIRONMENT=development
# ALLOW_UNSAFE_WEBHOOKS=true
# WEBHOOK_ALLOWED_DOMAINS='["receiver"]'
# WEBHOOK_FAIL_FIRST=0
